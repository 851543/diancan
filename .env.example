APP_ENV=production

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=diancan
MYSQL_PASSWORD=diancan
MYSQL_DB=diancan

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# 生产环境必须改成足够长的随机字符串
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=1440

# 浏览器访问的前端地址，逗号分隔。同域 Nginx 反代可不填
CORS_ORIGINS=https://admin.example.com,https://h5.example.com

# 仅用于 python -m app.seed 创建首个店员，创建后可从 .env 删掉
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 打包后台 / 真机顾客端时的 API 地址
VITE_API_BASE=https://api.example.com
